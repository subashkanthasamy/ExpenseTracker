rules_version = '2';

// Firestore security rules for Expense Tracker.
//
// Data model:
//   users/{uid}                                  — profile + household membership
//   households/{hid}                             — name, ownerUid, memberUids[], roles{}, inviteCode
//   households/{hid}/expenses|categories|assets|liabilities|budgets|savingsGoals|recurring
//
// These rules are the ONLY enforcement of the permission model. Both apps talk to Firestore
// directly with the end user's credentials — there is no server tier — so the role checks in
// `shared/domain/usecase/access/Permissions.kt` are for greying out buttons, nothing more.
// Change the two together.
//
// Roles
//   admin   — global, every household. Granted by the `admin` custom claim on the ID token.
//   owner   — the creator of one household (households/{hid}.ownerUid).
//   member  — may add and edit their OWN expenses. Nothing else that writes.
//   guest   — read-only.
//
// Why admin is a custom claim and not a field: `users/{uid}` is self-writable (see below), so
// a role field there would be self-grantable. Set it with the Admin SDK:
//   admin.auth().setCustomUserClaims(uid, { admin: true })
//
// Read the "Deployment notes" at the bottom before deploying — the backfill must run first.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Global superuser. `.get` so a token minted before the claim existed is false, not an error.
    function isAdmin() {
      return isSignedIn() && request.auth.token.get('admin', false) == true;
    }

    function householdData(hid) {
      return get(/databases/$(database)/documents/households/$(hid)).data;
    }

    // Owner of a household document.
    //
    // Falls back to memberUids[0] for households written before this model: the create rule
    // admits exactly one initial member and joins append, so index 0 is the creator.
    // tools/backfill-household-roles.js makes that permanent. The size guard matters because
    // a default argument is evaluated eagerly — indexing an empty list would error the whole
    // rule rather than deny it.
    function ownerOf(h) {
      return h.get('ownerUid', '') != ''
        ? h.get('ownerUid', '')
        : (h.memberUids.size() > 0 ? h.memberUids[0] : '');
    }

    // Role of the caller within a household document's data.
    function roleIn(h) {
      return isAdmin()
        ? 'admin'
        : (uid() == ownerOf(h)
            ? 'owner'
            : (uid() in h.memberUids
                // Absent from `roles` means a pre-roles member — treat as member so nobody
                // loses access in the window between deploying rules and running the backfill.
                ? h.get('roles', {}).get(uid(), 'member')
                : 'none'));
    }

    function isOwnerOf(h) { return roleIn(h) in ['admin', 'owner']; }
    function canWriteIn(h) { return roleIn(h) in ['admin', 'owner', 'member']; }
    function canReadIn(h) { return roleIn(h) != 'none'; }

    // ---- Users: strictly own document -------------------------------------

    match /users/{userId} {
      // Own document, plus any user who shares a household — the member list reads other
      // users' documents (HouseholdRepositoryImpl.getHouseholdMembers). Admins read any.
      allow get: if isSignedIn() && (
        uid() == userId
        || isAdmin()
        || resource.data.get('householdIds', []).hasAny(
             get(/databases/$(database)/documents/users/$(uid())).data.get('householdIds', [])
           )
      );
      // No enumerating the user collection.
      allow list: if false;

      // Note the absence of any role/permission field in the allowlist below. Roles live on
      // the household document, which the holder cannot write. If a role field is ever added
      // here it is self-grantable and the whole model collapses.
      allow create: if isSignedIn() && uid() == userId
        && request.resource.data.keys().hasOnly(
             ['email', 'displayName', 'householdIds', 'activeHouseholdId', 'createdAt', 'householdId'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.householdIds is list
        && request.resource.data.householdIds.size() <= 50;

      // Members manage their own profile; nobody else's. Admin may correct any.
      allow update: if isSignedIn() && (uid() == userId || isAdmin())
        && request.resource.data.keys().hasOnly(
             ['email', 'displayName', 'householdIds', 'activeHouseholdId', 'createdAt', 'householdId'])
        && (!('displayName' in request.resource.data)
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() <= 100))
        && (!('householdIds' in request.resource.data)
            || (request.resource.data.householdIds is list
                && request.resource.data.householdIds.size() <= 50))
        && (!('activeHouseholdId' in request.resource.data)
            || request.resource.data.activeHouseholdId == null
            || (request.resource.data.activeHouseholdId is string
                && request.resource.data.activeHouseholdId.size() <= 128));

      allow delete: if isAdmin();
    }

    // ---- Invite code lookup ----------------------------------------------
    //
    // Joining needs to resolve a code to a household *before* membership exists. Doing that by
    // querying `households` would require making every household readable to every signed-in
    // user — which leaks all household names and invite codes. So the lookup lives in its own
    // tiny collection, and only leaks to someone who already knows the code.
    //
    // Owner-only lifecycle: because only the owner can bring a code into existence, rotate it
    // or revoke it, possessing a valid code IS the owner's authorisation to join. That is how
    // "only the creator can add members" is expressed without a server. See the deployment
    // notes for the residual risk and the Cloud Function that removes it.
    match /inviteCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;  // no enumerating codes

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['householdId', 'householdName'])
        && request.resource.data.householdId is string
        && request.resource.data.householdId.size() <= 128
        && request.resource.data.householdName is string
        && request.resource.data.householdName.size() <= 100
        && isOwnerOf(householdData(request.resource.data.householdId));

      allow update, delete: if isSignedIn()
        && isOwnerOf(householdData(resource.data.householdId));
    }

    // ---- Households -------------------------------------------------------

    match /households/{hid} {
      // Any role including guest may read. Using resource.data rather than a get() both saves
      // a read and permits the "my households" query (memberUids arrayContains uid): for list
      // operations Firestore evaluates this per candidate document and accepts the query
      // because it is provably constrained to documents satisfying the rule.
      allow read: if isSignedIn() && (uid() in resource.data.memberUids || isAdmin());

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(
             ['name', 'ownerUid', 'memberUids', 'roles', 'inviteCode', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() >= 4
        && request.resource.data.inviteCode.size() <= 16
        && request.resource.data.createdAt is int
        // The creator owns it, is the only initial member, and grants nobody else a role.
        && request.resource.data.ownerUid == uid()
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() == 1
        && request.resource.data.memberUids[0] == uid()
        && request.resource.data.roles is map
        && request.resource.data.roles.keys().size() == 0;

      allow update: if isSignedIn() && (
        // --- Owner / admin: rename, admit, eject, change roles ---------------
        (
          isOwnerOf(resource.data)
          // Identity is immutable. Ownership transfer is deliberately not expressible here:
          // it would let a compromised session hand the household to an attacker permanently.
          && request.resource.data.ownerUid == ownerOf(resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
          && request.resource.data.memberUids is list
          && request.resource.data.memberUids.size() <= 20
          && request.resource.data.roles is map
          // The owner always remains a member, and memberUids must stay in step with roles —
          // otherwise the index and the authority disagree and the query lies.
          && request.resource.data.ownerUid in request.resource.data.memberUids
          && request.resource.data.memberUids.toSet() ==
             request.resource.data.roles.keys().toSet().union([request.resource.data.ownerUid].toSet())
        )
        ||
        // --- Member / guest: may only remove themselves ----------------------
        (
          roleIn(resource.data) in ['member', 'guest']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'roles'])
          && !(uid() in request.resource.data.memberUids)
          && !(uid() in request.resource.data.roles.keys())
          // Exactly themselves and nobody else.
          && resource.data.memberUids.toSet().difference(request.resource.data.memberUids.toSet())
             == [uid()].toSet()
        )
        ||
        // --- Join: a non-member adds only themselves, as a member ------------
        //
        // Reachable only by someone holding a code the owner issued (see /inviteCodes).
        (
          !(uid() in resource.data.memberUids)
          && !isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'roles'])
          && request.resource.data.memberUids is list
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
          && request.resource.data.memberUids.size() <= 20
          && uid() in request.resource.data.memberUids
          // Self-promotion guard: a joiner takes the 'member' role, never 'owner', and cannot
          // rewrite anyone else's.
          && request.resource.data.roles.get(uid(), '') == 'member'
          && request.resource.data.roles.diff(resource.data.get('roles', {})).affectedKeys()
             == [uid()].toSet()
          // No existing member may be dropped in the process.
          && resource.data.memberUids.toSet().difference(request.resource.data.memberUids.toSet()).size() == 0
        )
      );

      // Only the creator (or an admin) may delete. Firestore does not cascade, so the
      // subcollections are orphaned rather than removed — see the deployment notes.
      allow delete: if isSignedIn() && isOwnerOf(resource.data);

      // ---- Expenses: members own their own rows ---------------------------

      match /expenses/{docId} {
        allow read: if canReadIn(householdData(hid));

        // Guests cannot add. `addedBy` must be the caller — without this a member could file
        // an expense against someone else, which also poisons the per-member spending split.
        allow create: if canWriteIn(householdData(hid))
          && request.resource.data.addedBy == uid()
          && (!('householdId' in request.resource.data)
              || request.resource.data.householdId == hid)
          && request.resource.data.keys().size() <= 40;

        // Your own rows, or anyone's if you own the household. Reassignment is blocked so a
        // row cannot be edited out of your ownership and then edited freely.
        allow update: if (
            isOwnerOf(householdData(hid))
            || (canWriteIn(householdData(hid)) && resource.data.addedBy == uid())
          )
          && request.resource.data.addedBy == resource.data.addedBy
          && (!('householdId' in request.resource.data)
              || request.resource.data.householdId == hid)
          && request.resource.data.keys().size() <= 40;

        allow delete: if isOwnerOf(householdData(hid))
          || (canWriteIn(householdData(hid)) && resource.data.addedBy == uid());
      }

      // ---- Shared configuration: owner only -------------------------------
      //
      // Categories, budgets, savingsGoals, recurring, assets, liabilities. Members contribute
      // expenses; they do not reshape the household. Everyone including guests may read, or
      // the expense list could not render a category name.

      match /{collection}/{docId} {
        allow read: if canReadIn(householdData(hid));

        allow create, update: if isOwnerOf(householdData(hid))
          && (!('householdId' in request.resource.data)
              || request.resource.data.householdId == hid)
          && request.resource.data.keys().size() <= 40;

        allow delete: if isOwnerOf(householdData(hid));
      }
    }
  }
}

// ---- Deployment notes -------------------------------------------------------
//
// ORDER MATTERS. Run tools/backfill-household-roles.js BEFORE deploying these rules on a
// database that already has households. The rules tolerate a missing `ownerUid` by falling
// back to memberUids[0], so a skipped backfill is not fatal — but a household whose creator
// has since left would be owned by whoever now sits at index 0, which is not what you want.
//
// Granting admin (server-side only, never from a client):
//   admin.auth().setCustomUserClaims(uid, { admin: true })
// The claim reaches the rules on the client's NEXT ID token refresh — up to an hour, or
// immediately after getIdToken(true).
//
// Client support required by these rules:
//   1. Create writes ownerUid = the creator and roles = {}.
//   2. Join writes memberUids arrayUnion(uid) AND roles.<uid> = 'member' in one update.
//      Writing only memberUids now fails the join branch.
//   3. Only the owner's client should attempt category seeding — a member calling
//      seedPresetCategories will be denied. iOS wraps those writes in `try?`, so it fails
//      silently and the member sees an empty category list rather than an error.
//
// Deploy with:  firebase deploy --only firestore:rules
//
// Accepted residual risks:
//   - Anyone holding a current invite code can join. Only the owner can mint or rotate a code,
//     so this is the owner's authorisation — but a code shared onward by a member works until
//     rotated. Closing it fully means moving the join into a Cloud Function that is the sole
//     writer of memberUids/roles, then setting the join branch to `if false`.
//   - Deleting a household orphans its subcollections. The same Function should cascade.
//   - Field types inside subcollections are still unvalidated beyond addedBy and householdId,
//     so a member can write a wrongly-typed field — the shape of the earlier
//     "Field 'date' is not a java.lang.Number" crash.
