<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon background: the app's brand gradient.

    Replaces the Android Studio template background (#3DDC84 plus a grid of guide lines).
    Colours match AppColors.gradient on iOS (0xFF7B61FF -> 0xFFE040FB -> 0xFFFF8A65) so both
    platforms ship the same mark. The foreground layer is
    drawable-*dpi/ic_launcher_foreground.png — a white rupee sign kept inside the 66dp safe
    zone — which also serves as the monochrome layer for themed icons.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:color="#FF7B61FF" android:offset="0.0" />
                <item android:color="#FFE040FB" android:offset="0.55" />
                <item android:color="#FFFF8A65" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
