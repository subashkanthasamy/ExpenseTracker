{
  "name": "expense-tracker-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "(cd .. && ./gradlew :shared:jsBrowserProductionLibraryDistribution) && npm run build && netlify deploy --prod --dir=dist",
    "deploy:draft": "(cd .. && ./gradlew :shared:jsBrowserProductionLibraryDistribution) && npm run build && netlify deploy --dir=dist"
  },
  "dependencies": {
    "@js-joda/core": "3.2.0",
    "expensetracker-shared": "file:../shared/build/dist/js/productionLibrary",
    "firebase": "^11.10.0",
    "format-util": "^1.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^5.4.19"
  }
}
