# Firebase Web app config — Firebase console > Project settings > Your apps > Add app > Web.
# This is a separate app registration from Android and iOS; it is NOT in google-services.json.
# These values are public by design (they identify the project, they do not authorise anything —
# firestore.rules does that). Copy to web/.env and fill in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
